# Copy to .env and fill in. .env is gitignored — never commit it.
#
# The OAuth client comes from https://oauth.iracing.com/accountmanagement
# and MUST be authorised for the "password_limited" grant. That grant is not
# enabled by default — iRacing enables it per client on request.
IRACING_EMAIL=
IRACING_PASSWORD=
IRACING_CLIENT_ID=
IRACING_CLIENT_SECRET=
